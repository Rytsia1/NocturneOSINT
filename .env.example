# Backend runtime configuration. Copy to .env and adjust for local development.
# Never commit the real .env file.

APP_ENV=development
PORT=8080
DATABASE_URL=postgres://nocturne:nocturne@localhost:5432/nocturne?sslmode=disable
LOG_LEVEL=info

# Used by docker-compose.yml to provision the Postgres/PostGIS container.
POSTGRES_USER=nocturne
POSTGRES_PASSWORD=nocturne
POSTGRES_DB=nocturne
